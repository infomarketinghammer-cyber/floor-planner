PORT=4000
FASTAPI_URL=http://127.0.0.1:8000
# Must match backend/.env JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Keep in sync with backend MAX_UPLOAD_MB
MAX_UPLOAD_MB=25

# Production only: HTTP is redirected to HTTPS. Set to false only if TLS is fully handled
# in front of the gateway.
# FORCE_HTTPS=true

# Proxies in front of the gateway, for the client IP used by rate limits (see README
# "Deployment"). 1 locally; behind Vercel and Render, start with 2 and check the logs.
# TRUST_PROXY=1
