MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=floor_planner
# Must match gateway/.env JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Seeded on startup if no admin exists
ADMIN_EMAIL=admin@floorplanner.app
ADMIN_PASSWORD=change-me-admin

# Uploads
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50
# Optional: path to ODA File Converter to accept DWG files (else users are asked for DXF/PDF)
# ODA_CONVERTER_PATH=C:\Program Files\ODA\ODAFileConverter 25.12.0\ODAFileConverter.exe

# Blueprint extraction (PRD 4.2). Digital PDFs and DXF/DWG are read without AI.
# Photos and scanned pages need a vision model; leave the key unset to disable (users
# then get a "add rooms manually / import a list" message instead).
# ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5-5
# VISION_EFFORT=high

# Emailing the shopping list, through Resend (https://resend.com). Leave unset to disable.
# EMAIL_FROM must use a domain you have verified in Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Floor Planner <lists@yourdomain.com>
